# Production API base: the Go gateway's public HTTPS ingress (Phase 2).
# Vercel's project env var of the same name should match this.
VITE_API_URL=https://inkshield-api.duckdns.org

# Google OAuth Client ID (Web) — public value, safe to commit. Baked into the
# Vercel build; enables the "Sign in with Google" button on the deployed site.
VITE_GOOGLE_CLIENT_ID=199863403782-kbmslm9slo02lam58fkpbffh9n4ffgs7.apps.googleusercontent.com
